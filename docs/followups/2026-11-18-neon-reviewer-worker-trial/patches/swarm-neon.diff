+    def test_trim_response_preamble_strips_narration_before_exact_header(self) -> None:
+        trim = self.module.trim_response_preamble
+        body = "# unit_a result\nConclusion: complete\nFiles: none"
+        self.assertEqual(
+            trim(f"I checked the files first.\n\n{body}\n", "unit_a"),
+            (body, True),
+        )
+        # CRLF line endings match the exact header line and keep the body intact.
+        crlf_body = "# unit_a result\r\nConclusion: complete\r\nFiles: none"
+        self.assertEqual(
+            trim(f"Opening narration.\r\n{crlf_body}\r\n", "unit_a"),
+            (crlf_body, True),
+        )
+        # Multiple matching headers cut at the first match.
+        repeated = f"{body}\n\n# unit_a result\nSecond copy"
+        self.assertEqual(
+            trim(f"Opening narration.\n{repeated}\n", "unit_a"),
+            (repeated, True),
+        )
+
+    def test_trim_response_preamble_leaves_header_first_and_no_header_alone(self) -> None:
+        trim = self.module.trim_response_preamble
+        body = "# unit_a result\nConclusion: complete\nFiles: none"
+        # Header first, with body, with no trailing content, with leading
+        # whitespace only, or with a repeated header later.
+        for label, text, expected in (
+            ("header-first", f"{body}\n", body),
+            ("header-only", "# unit_a result", "# unit_a result"),
+            ("whitespace-prefix", f"\n\n   \n{body}\n", body),
+            ("header-first-repeated", f"{body}\n# unit_a result\nMore\n", f"{body}\n# unit_a result\nMore"),
+            ("no-header", "Conclusion: complete\nFiles: none\n", "Conclusion: complete\nFiles: none"),
