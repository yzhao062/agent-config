+    def test_narration_before_header_is_trimmed_and_full_response_stored_beside(self) -> None:
+        narration = "I'll start by reading the target file and running the checks.\n\n"
+        body = (
+            "# unit_a result\n"
+            "Conclusion: complete\n"
+            "Files: none\n"
+            "Open items: none\n"
+            "Verification: mock\n"
+        )
+        full = narration + body
+        result, target = self._run(extra_env={"MOCK_AGY_RESPONSE": full})
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(target.read_text(encoding="utf-8"), body)
+        beside = self.root / "unit-result.response.md"
+        self.assertEqual(beside.read_text(encoding="utf-8"), full)
+
+    def test_header_first_publishes_unchanged_without_response_file(self) -> None:
+        body = (
+            "# unit_a result\n"
+            "Conclusion: complete\n"
+            "Files: none\n"
+            "Open items: none\n"
+            "Verification: mock\n"
+        )
+        for index, raw in enumerate((body, "\n\n" + body)):
+            with self.subTest(index=index):
+                target = self.root / f"unit-result-header-{index}.md"
+                result, target = self._run(
+                    result_path=target,
+                    extra_env={"MOCK_AGY_RESPONSE": raw},
+                )
+                self.assertEqual(result.returncode, 0, result.stderr)
+                self.assertEqual(target.read_text(encoding="utf-8"), body)
+                self.assertFalse(
+                    (self.root / f"unit-result-header-{index}.response.md").exists()
+                )
+
