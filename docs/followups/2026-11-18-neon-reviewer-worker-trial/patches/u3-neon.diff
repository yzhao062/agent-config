+def trim_leading_narration(text: str, unit_id: str) -> str | None:
+    """Return ``text`` from the first ``# <unit-id> result`` line onward, or ``None``.
+
+    Returns ``None`` when the header line is absent or is already the first
+    non-empty line, so callers publish the response unchanged and write no
+    sibling file.
+    """
+    header = f"# {unit_id} result"
+    lines = text.strip().splitlines()
+    try:
+        index = lines.index(header)
+    except ValueError:
+        return None
+    if index == 0:
+        return None
+    return "\n".join(lines[index:])
+
+
