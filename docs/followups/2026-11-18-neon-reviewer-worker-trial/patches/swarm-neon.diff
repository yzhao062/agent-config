+            ("trailing-space-header", "Narration.\n# unit_a result \nDone\n", "Narration.\n# unit_a result \nDone"),
+            ("indented-header", "Narration.\n  # unit_a result\nDone\n", "Narration.\n  # unit_a result\nDone"),
+            ("wrong-unit-header", "Narration.\n# unit_b result\nDone\n", "Narration.\n# unit_b result\nDone"),
+        ):
+            with self.subTest(label):
