+def trim_leading_narration(response: str, unit_id: str) -> tuple[str, bool]:
+    """Return ``(published, trimmed)`` from a non-empty final response.
+
+    Agy workers often open their final response with progress narration before
+    ``# <unit_id> result``. When that header appears on its own line after other
+    non-empty text, publish from that line onward; otherwise publish unchanged.
+    """
+    stripped = response.strip()
+    lines = stripped.splitlines()
+    header = f"# {unit_id} result"
+    if lines and lines[0] != header:
+        for index, line in enumerate(lines[1:], start=1):
+            if line == header:
+                return "\n".join(lines[index:]) + "\n", True
+    return stripped + "\n", False
+
+
