+    def test_narration_before_header_is_trimmed_and_full_response_stored_beside(
+        self,
+    ) -> None:
+        # Agy workers often open with progress narration before the required
+        # `# <unit-id> result` line. Publish from the header onward and keep
+        # the full response beside it.
+        body = (
+            "# unit_a result\n"
+            "Conclusion: complete\n"
+            "Files: none\n"
+            "Open items: none\n"
+            "Verification: mock\n"
+        )
+        full = (
+            "I'll start by reading the files and checking section 3.\n"
+            "I will format the summary under # unit_a result once verified.\n\n"
+            + body
+        )
+        target = self.root / "unit-result.md"
+        result, target = self._run(
+            result_path=target,
+            extra_env={"MOCK_AGY_RESPONSE": full},
+        )
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(target.read_text(encoding="utf-8"), body)
+        beside = self.root / "unit-result.response.md"
+        self.assertEqual(beside.read_text(encoding="utf-8"), full)
+
+    def test_header_first_response_publishes_unchanged_with_no_sibling_file(
+        self,
+    ) -> None:
+        body = (
+            "# unit_a result\n"
+            "Conclusion: complete\n"
+            "Files: none\n"
+            "Open items: none\n"
+            "Verification: mock\n"
+        )
+        for label, response in (
+            ("line-0", body),
+            ("leading-blank-lines", "\n\n" + body),
+        ):
+            with self.subTest(label=label):
+                target = self.root / f"unit-result-{label}.md"
+                result, target = self._run(
+                    result_path=target,
+                    extra_env={"MOCK_AGY_RESPONSE": response},
+                )
+                self.assertEqual(result.returncode, 0, result.stderr)
+                self.assertEqual(target.read_text(encoding="utf-8"), body)
+                beside = self.root / f"unit-result-{label}.response.md"
+                self.assertFalse(beside.exists())
+
